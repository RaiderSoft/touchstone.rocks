# Touchstone environment configuration
# Copy this file to .env and fill in your values.

# KataGo (REQUIRED for game play)
KATAGO_MODEL=            # Path to neural net model (.bin.gz) — REQUIRED
KATAGO_HUMAN_MODEL=      # Path to human SL model for difficulty profiles (default: same as KATAGO_MODEL)
KATAGO_PATH=             # Path to katago binary (default: /opt/homebrew/bin/katago)
KATAGO_CONFIG=           # Path to analysis config file (default: KataGo defaults)
KATAGO_ANALYSIS_VISITS=  # Default analysis visits (default: 200)

# AI Chat (at least one key needed for chat overlay)
GEMINI_API_KEY=
CLAUDE_API_KEY=
